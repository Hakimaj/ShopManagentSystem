PROJECT_NAME="CleanCare POS API"
API_STR="/api"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database configuration
DATABASE_SERVER=localhost
DATABASE_USER=root

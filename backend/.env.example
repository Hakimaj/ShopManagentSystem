# ==============================================
# CleanCare POS & Shop Management System
# Backend Environment Configuration Template
# ==============================================

# Application Settings
PROJECT_NAME="CleanCare POS API"
APP_NAME="CleanCare POS"
APP_ENV=production
API_STR=/api

# Authentication & Security
SECRET_KEY=your_secure_jwt_secret_key_here
JWT_SECRET=your_secure_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Aiven MySQL / Local MySQL)
DATABASE_URL=
DATABASE_SERVER=localhost
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_DB=defaultdb
DATABASE_PORT=3306
DATABASE_SSL_CA=ca.pem
USE_SQLITE=false

# Aliases supported:
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
DB_SSL_CA=

# CORS and Frontend URL
FRONTEND_URL=https://your-app.vercel.app
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]
